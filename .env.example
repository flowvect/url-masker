# URL Shortener & Masking Tool — Environment Configuration
# Copy this file to .env and update values for your environment.

# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/url_masker

# Secret key for JWT signing — CHANGE THIS in production
SECRET_KEY=change-me-to-a-random-secret-key

# Environment: development | staging | production
ENVIRONMENT=development

# Public base URL used to construct short links
BASE_URL=http://localhost:8000

# Cache TTL in seconds for hot short-code lookups
CACHE_TTL=300

# Maximum links an anonymous user can create per hour
RATE_LIMIT_ANON=20

# Maximum links a registered user can create per hour
RATE_LIMIT_USER=100
