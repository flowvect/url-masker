# URL Shortener & Masking Tool — Environment Configuration
# Copy this file to .env and customize for your local or cloud environment.
# ──────────────────────────────────────────────────────────────────────────

# Database connection string (e.g. Neon.tech, Supabase, Railway, or local PostgreSQL)
# Standard postgres:// and postgresql+asyncpg:// are both supported.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/url_masker

# Secret key for JWT signing — CHANGE THIS in production
SECRET_KEY=change-me-to-a-random-secret-key

# Environment mode: development | staging | production
ENVIRONMENT=development

# Public Base URL used to construct short links
# Local: http://localhost:8000 | Vercel: https://url-masker-test.vercel.app
BASE_URL=http://localhost:8000

# Vercel domain (automatically provided by Vercel, or configure manually)
VERCEL_URL=url-masker-test.vercel.app

# GitHub repository link for header navigation
GITHUB_REPO_URL=https://github.com/flowvect/url-masker

# In-memory cache TTL in seconds for hot short-code lookups
CACHE_TTL=300

# Rate limits (links created per hour)
RATE_LIMIT_ANON=20
RATE_LIMIT_USER=100
